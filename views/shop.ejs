<%- include("includes/head.ejs") %>
<link rel="stylesheet" href="css/shop.css">
<div class="wrapper">
  <h1 class="title">Welcome to perfume store</h1>

  <% if (prods.length > 0 ) { %>
    <div class="productsList">
      <% for (let product of prods) { %>
        <div>
          <div>
            <h1> <%= product.title %> </h1>
            <img src="https://cdn.shopify.com/s/files/1/0554/2998/8522/files/33_480x480.jpg?v=1672391447" alt="dior sauvage" />
            <h2> price $80</h2>
            <p> description here</p>
          </div>
        </div>
      <% } %>
      <% } else { %>
        <h2>No perfumes found</h2>
    </div>
  <% } %>
  </div>
</body>

